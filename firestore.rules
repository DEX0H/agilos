rules_version = '2';

// Agilos: profiles (username + password), per-player match stats and lobby signaling.
// A player can only read and write their own documents. Stats come from the player's own
// game, so they can't be fully trusted; these rules reject malformed or impossible values.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function validName(n) { return n is string && n.matches('^[A-Za-z0-9_-]{3,16}$'); }
    function validColour(c) { return c is string && c.matches('^#[0-9a-fA-F]{6}$'); }
    function count(v, max) { return v is int && v >= 0 && v <= max; }
    function amount(v, max) { return (v is int || v is float) && v >= 0 && v <= max; }
    // The username is the login (<username>@agilos.players), so it is unique and can only
    // be claimed by the account that signed up with it
    function ownName(n) { return validName(n) && request.auth.token.email == n.lower() + '@agilos.players'; }

    match /players/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'colour', 'createdAt', 'settings', 'totals'])
        && validName(request.resource.data.name)
        && validColour(request.resource.data.colour)
        && ownName(request.resource.data.name);
      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'colour', 'createdAt', 'settings', 'totals'])
        && validName(request.resource.data.name)
        && validColour(request.resource.data.colour)
        && request.resource.data.name == resource.data.name
        && (!('settings' in request.resource.data) || request.resource.data.settings is map)
        && (!('totals' in request.resource.data) || validTotals(request.resource.data.totals));

      function validTotals(t) {
        return t is map
          && count(t.matches, 1000000) && count(t.wins, t.matches)
          && count(t.kills, 20000000) && count(t.deaths, t.matches)
          && amount(t.damageDealt, 2000000000) && amount(t.damageTaken, 2000000000);
      }

      // One record per finished match; never edited afterwards
      match /matches/{matchId} {
        allow read, delete: if isOwner(uid);
        allow update: if false;
        allow create: if isOwner(uid)
          && request.resource.data.endedAt == request.time
          && count(request.resource.data.total, 16) && request.resource.data.total >= 2
          && count(request.resource.data.place, request.resource.data.total) && request.resource.data.place >= 1
          && count(request.resource.data.kills, request.resource.data.total - 1)
          && count(request.resource.data.deaths, 1)
          && count(request.resource.data.headshots, request.resource.data.kills)
          && count(request.resource.data.hits, request.resource.data.shots)
          && count(request.resource.data.shots, 100000)
          && count(request.resource.data.timeAlive, 3600)
          && amount(request.resource.data.damageDealt, 100000)
          && amount(request.resource.data.damageTaken, 100000)
          && request.resource.data.win is bool
          && (request.resource.data.win == false || request.resource.data.place == 1);
      }
    }

    // Lobbies: a player hosts one under a 6-letter code; friends with the code leave a
    // WebRTC connection offer the host's game answers. After that the games talk directly.
    // Codes can be looked up but not listed, so a lobby can only be found with its code.
    match /lobbies/{code} {
      function validCode() { return code.matches('^[A-HJ-NP-Z]{6}$'); }
      allow get: if signedIn();
      allow list, update: if false;
      allow create: if signedIn() && validCode()
        && request.resource.data.keys().hasOnly(['host', 'name', 'max', 'createdAt', 'expireAt'])
        && request.resource.data.host == request.auth.uid
        && ownName(request.resource.data.name)
        && request.resource.data.max is int && request.resource.data.max >= 2 && request.resource.data.max <= 16
        && request.resource.data.createdAt == request.time
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt <= request.time + duration.value(3, 'h');
      allow delete: if signedIn() && resource.data.host == request.auth.uid;

      // One per joining player: their offer, then the host's answer. Only the two of them
      // can read it (it holds network addresses), and it is deleted once they connect.
      match /peers/{uid} {
        function lobbyPath() { return /databases/$(database)/documents/lobbies/$(code); }
        function isHost() { return signedIn() && exists(lobbyPath()) && get(lobbyPath()).data.host == request.auth.uid; }
        function sdp(v) { return v is string && v.size() < 20000; }
        allow get: if isOwner(uid) || isHost();
        allow list: if isHost();
        allow create: if isOwner(uid) && exists(lobbyPath())
          && request.resource.data.keys().hasOnly(['offer', 'name', 'colour', 'at'])
          && sdp(request.resource.data.offer)
          && ownName(request.resource.data.name)
          && validColour(request.resource.data.colour)
          && request.resource.data.at == request.time;
        allow update: if isHost()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer'])
          && sdp(request.resource.data.answer);
        allow delete: if isOwner(uid) || isHost();
      }
    }
  }
}
